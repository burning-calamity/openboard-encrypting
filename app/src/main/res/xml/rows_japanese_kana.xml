<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/key_styles_common" />
    <include latin:keyboardLayout="@xml/row_optional_number_row" />
    <Row latin:keyWidth="8.333%p" latin:keyLabelFlags="fontNormal">
        <include latin:keyboardLayout="@xml/rowkeys_japanese_kana1" />
    </Row>
    <Row latin:keyWidth="8.333%p" latin:keyLabelFlags="fontNormal">
        <include latin:keyboardLayout="@xml/rowkeys_japanese_kana2" />
    </Row>
    <Row latin:keyWidth="10%p" latin:keyLabelFlags="fontNormal">
        <include latin:keyboardLayout="@xml/rowkeys_japanese_kana3" />
    </Row>
    <Row latin:keyWidth="8%p" latin:keyLabelFlags="fontNormal">
        <Key latin:keyStyle="shiftKeyStyle" latin:keyWidth="10%p" />
        <include latin:keyboardLayout="@xml/rowkeys_japanese_kana4" />
        <Key latin:keyStyle="deleteKeyStyle" latin:keyWidth="fillRight" />
    </Row>
    <include latin:keyboardLayout="@xml/row_qwerty4" />
</merge>
